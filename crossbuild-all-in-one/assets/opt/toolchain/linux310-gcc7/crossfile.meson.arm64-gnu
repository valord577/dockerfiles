[constants]
prefix = ''
ccache = []
arch   = 'arm64'
info   = 'gnu'
triple = 'aarch64-unknown-linux'
dynamic_linker = '/lib/ld-linux-aarch64.so.1'
ccflags_extras = ['-march=armv8-a']

sysroot_triple = triple+'-'+info
sysroot_dir = '@DIRNAME@' / sysroot_triple
gccroot_dir = sysroot_dir / 'usr'
ccflags = ['--target='+triple, '--gcc-toolchain='+gccroot_dir, '--gcc-triple='+sysroot_triple, '--sysroot='+sysroot_dir] + ccflags_extras
ldflags = ['-fuse-ld=lld', '--sysroot='+sysroot_dir, '-Wl,--dynamic-linker='+dynamic_linker]

[host_machine]
system = 'linux'
kernel = 'linux'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'

[properties]
needs_exe_wrapper = false
cmake_defaults    = false
cmake_toolchain_file = '@DIRNAME@/crossfile.cmake.'+arch+'-'+info

[binaries]
c   = ccache + [prefix / 'clang']   + ccflags
cpp = ccache + [prefix / 'clang++'] + ccflags
ar = prefix / 'llvm-ar'
as = prefix / 'llvm-as'
nm = prefix / 'llvm-nm'
objcopy = prefix / 'llvm-objcopy'
strip   = prefix / 'llvm-strip'
ranlib  = prefix / 'llvm-ranlib'
pkg-config = '@DIRNAME@/pkgconf-wrapper.'+arch+'-'+info
cmake = 'cmake'

[built-in options]
c_link_args   = ldflags
cpp_link_args = ldflags
